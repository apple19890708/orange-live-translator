{
  "manifest_version": 3,
  "name": "Orange Live Translate（本機字幕翻譯）",
  "version": "0.1.0",
  "description": "把 YouTube 日文字幕／即時聽譯結果翻成繁體中文，疊在影片上。翻譯全部在本機完成。",
  "permissions": ["storage", "tabCapture", "offscreen"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Orange Live Translate" },
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "開始／停止聽譯目前分頁"
    },
    "toggle-overlay": {
      "suggested_key": { "default": "Alt+T" },
      "description": "顯示／隱藏翻譯字幕"
    }
  }
}
